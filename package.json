    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "postcss": "^8.5.1",
    "tailwindcss": "4.3.5",
